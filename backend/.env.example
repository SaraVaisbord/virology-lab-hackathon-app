# Copy this file to .env and fill in your key. NEVER commit .env.
#
# WARNING: page images are sent to Google's Gemini API.
# Review https://ai.google.dev/gemini-api/terms before processing real medical records.
GEMINI_API_KEY=your-key-here
# More keys are tried automatically when one runs out of quota / is rejected — either numbered:
# GEMINI_API_KEY_2=second-key
# GEMINI_API_KEY_3=third-key
# ...or as a list: GEMINI_API_KEYS=second-key,third-key
# Quota is per Google Cloud project — keys from the SAME project share one quota and won't help.

# Everything below is optional — defaults live in config.py.
# GEMINI_MODEL=models/gemini-flash-latest
# Models to switch to when the primary is overloaded (503/504) or out of quota on every key, in order:
# GEMINI_FALLBACK_MODELS=models/gemini-flash-lite-latest
# GEMINI_TIMEOUT_SECONDS=120
# WORKER_CONCURRENCY=2
# DEFAULT_PAGE_SIZE=50
# RECEIVED_DATE_MAX_AGE_DAYS=365
# EXTRACTION_PROMPT_FILE=extraction_prompt.md
# CORS_ORIGINS=http://localhost:5173
# APP_DATA_DIR=/absolute/path/to/data
# DATABASE_URL=sqlite:////absolute/path/to/app.db
